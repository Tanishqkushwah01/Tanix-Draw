# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tkdraw?retryWrites=true&w=majority

# Auth (generate a long random string, e.g. with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Email (Brevo API, used for OTP emails)
BREVO_API_KEY=
EMAIL_FROM=

# CORS: frontend URL(s), comma separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Production only (leave as-is for local development)
TRUST_PROXY=false
COOKIE_SAMESITE=lax
COOKIE_SECURE=false